{
  "name": "dhcp",
  "version": "1.0.1",
  "description": "Type-safe DHCPv4 client, server, relay-aware watcher, and packet tools for Node.js",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./options": {
      "types": "./dist/types/options.d.ts",
      "import": "./dist/esm/options.js",
      "require": "./dist/cjs/options.js"
    },
    "./protocol": {
      "types": "./dist/types/protocol.d.ts",
      "import": "./dist/esm/protocol.js",
      "require": "./dist/cjs/protocol.js"
    },
    "./sequential-buffer": {
      "types": "./dist/types/sequential-buffer.d.ts",
      "import": "./dist/esm/sequential-buffer.js",
      "require": "./dist/cjs/sequential-buffer.js"
    },
    "./tools": {
      "types": "./dist/types/tools.d.ts",
      "import": "./dist/esm/tools.js",
      "require": "./dist/cjs/tools.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "examples",
    "res",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "dhcp": "./bin/dhcp-cli.js",
    "dhcpd": "./bin/dhcpd-cli.js"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "npm run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && tsc -p tsconfig.types.json && node scripts/finalize-build.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node test/run.cjs",
    "test:coverage": "c8 --all --src dist/cjs npm test",
    "prepublishOnly": "npm run lint && npm test"
  },
  "keywords": [
    "dhcp",
    "network",
    "server",
    "client",
    "bootp",
    "udp",
    "pxe",
    "network-configuration",
    "typescript"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/rawify"
  },
  "author": {
    "name": "Robert Eisele",
    "email": "robert@raw.org",
    "url": "https://raw.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rawify/dhcp.js.git"
  },
  "bugs": {
    "url": "https://github.com/rawify/dhcp.js/issues"
  },
  "homepage": "https://raw.org/software/libraries/dhcp-js/",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.10.2",
    "c8": "^10.1.3",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.67.0"
  }
}